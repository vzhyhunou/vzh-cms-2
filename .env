LOGGER_OPTIONS=logger/production

DATASOURCE_TYPE=sqlite
DATASOURCE_DATABASE=:memory:
DATASOURCE_LOGGING=false
DATASOURCE_AUTO_LOAD_ENTITIES=true
DATASOURCE_SYNCHRONIZE=true
DATASOURCE_CHARSET=utf8mb4
DATASOURCE_SUPPORT_BIG_NUMBERS=false

CONFIG_PORT=8090

# 1 day
AUTH_EXPIRATION=86400
AUTH_SECRET=JwtSecretKey

RESOURCES_PATH=resources
RESOURCES_IMP_PATH=${RESOURCES_PATH}/import/cms.zip
RESOURCES_EXP_PATH=${RESOURCES_PATH}/export
# every day
RESOURCES_EXP_CRON=0 0 3 * * *
RESOURCES_EXP_PATTERN=YYYYMMDDHHmm
RESOURCES_EXP_LIMIT=5

LOCATION_PUBLIC=dist/public
LOCATION_STATIC=${RESOURCES_PATH}/public/static

STORAGE_ORIGIN=${LOCATION_STATIC}/origin