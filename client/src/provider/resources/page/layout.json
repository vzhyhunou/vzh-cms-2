  "body": "<Component schema=\"page\" name=\"one\" id=\"style\"/>\n{(([open, setOpen]) => (\n  <>\n    <AppBar>\n      <Toolbar>\n        <Link to=\"/\">\n          <IconButton color=\"inherit\">\n            <SvgIcon>\n              <path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\" />\n            </SvgIcon>\n          </IconButton>\n        </Link>\n        <Box sx={{ flexGrow: 1 }} />\n        {(([to, icon]) => (\n          <Link to={to}>\n            <IconButton color=\"inherit\">\n              <SvgIcon>\n                <path d={icon} />\n              </SvgIcon>\n            </IconButton>\n          </Link>\n        ))(\n          (({ permissions: p }, { paramId }) =>\n            p\n              ? p.includes('PAGES_EDITOR')\n                ? [\n                    paramId ? `/admin/page/${paramId}` : '/admin/page',\n                    'M3 17.25V21h3.75L17.81 9.94l-3.75-3.75zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75z'\n                  ]\n                : [\n                    p.includes('MANAGER') ? '/admin/user' : '/admin',\n                    'M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6'\n                  ]\n              : [\n                  '/login',\n                  'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m0 4c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6m0 14c-2.03 0-4.43-.82-6.14-2.88C7.55 15.8 9.68 15 12 15s4.45.8 6.14 2.12C16.43 19.18 14.03 20 12 20'\n                ])(usePermissions(), useParams())\n        )}\n        <IconButton onClick={() => setOpen(true)} color=\"inherit\">\n          <SvgIcon>\n            <path d=\"M3 18h18v-2H3zm0-5h18v-2H3zm0-7v2h18V6z\" />\n          </SvgIcon>\n        </IconButton>\n      </Toolbar>\n    </AppBar>\n    <Drawer\n      open={open}\n      onClose={() => setOpen(false)}\n      sx={{ '& .MuiDrawer-paper': { width: 240 } }}\n      anchor=\"right\"\n    >\n      <Toolbar>\n        <IconButton onClick={() => setOpen(false)}>\n          <SvgIcon>\n            <path d=\"M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z\" />\n          </SvgIcon>\n        </IconButton>\n      </Toolbar>\n      <Divider />\n      <Box onClick={() => setOpen(false)}>\n        <Component schema=\"page\" name=\"menu\" />\n      </Box>\n    </Drawer>\n  </>\n))(useState(false))}\n<Toolbar/>\n<Container fixed component=\"main\">\n <Outlet/>\n</Container>"
}
