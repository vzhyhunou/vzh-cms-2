{
  "id": "page",
  "entities": [
    "{\n  \"name\": \"page\",\n  \"columns\": {\n    \"id\": {\n      \"type\": \"varchar\",\n      \"primary\": true\n    },\n    \"title\": {\n      \"type\": \"varchar\",\n      \"nullable\": true\n    },\n    \"body\": {\n      \"type\": \"text\"\n    }\n  }\n}"
  ],
  "list": "<List filters={[<TextInput source=\"id\" alwaysOn/>]} exporter={false}>\n <Datagrid rowClick={false}>\n  <TextField source=\"id\"/>\n  <TextField source=\"title\"/>\n  <EditButton/>\n </Datagrid>\n</List>",
  "create": "<Create>\n <SimpleForm>\n  <TextInput source=\"id\" validate={[required()]}/>\n  <TextInput source=\"title\"/>\n  <TextInput multiline source=\"body\" sx={{'.MuiInputBase-input': {fontFamily: 'Courier New'}}}/>\n </SimpleForm>\n</Create>",
  "edit": "<Edit>\n <SimpleForm>\n  <TextInput source=\"title\"/>\n  <TextInput multiline source=\"body\" sx={{'.MuiInputBase-input': {fontFamily: 'Courier New'}}}/>\n </SimpleForm>\n</Edit>",
  "components": [
    {
      "name": "one",
      "findOne": true,
      "findOptions": "{\n  \"select\": {\n    \"title\": true,\n    \"body\": true\n  },\n  \"where\": {\n    \"id\": params.id\n  }\n}",
      "element": "<Parser jsx={content.body}/>",
      "title": "content.title"
    },
    {
      "name": "menu",
      "findOne": false,
      "findOptions": "{\n  \"select\": {\n    \"id\": true,\n    \"title\": true\n  }\n}",
      "transform": "content.map(({id, title}) => ({path: `/${id}`, title}))",
      "element": "<List>\n {content.map(i =>\n  <Link to={i.path}>\n   <ListItem>\n    <ListItemText primary={i.title}/>\n   </ListItem>\n  </Link>\n )}\n</List>"
    }
  ]
}
