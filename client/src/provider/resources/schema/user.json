  "create": "<Create>\n <SimpleForm>\n  <TextInput source=\"id\" validate={[required()]}/>\n  <PasswordInput source=\"password\" validate={[minLength(5)]}/>\n </SimpleForm>\n</Create>",
  "edit": "<Edit>\n <SimpleForm>\n  <PasswordInput source=\"password\" validate={[minLength(5)]}/>\n </SimpleForm>\n</Edit>"
}
