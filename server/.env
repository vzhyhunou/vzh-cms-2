LOGGER_OPTIONS=logger/production

DATASOURCE_TYPE=sqlite
DATASOURCE_DATABASE=:memory:
DATASOURCE_LOGGING=false
DATASOURCE_AUTO_LOAD_ENTITIES=true
DATASOURCE_SYNCHRONIZE=true
DATASOURCE_CHARSET=utf8mb4
DATASOURCE_SUPPORT_BIG_NUMBERS=false

CONFIG_PORT=8090

# 1 day
AUTH_EXPIRATION=86400
AUTH_SECRET=JwtSecretKey

STORAGE_PATH=../storage
IMP_PATH=${STORAGE_PATH}/import/cms.zip
EXP_PATH=${STORAGE_PATH}/export
# every day
EXP_CRON=0 0 3 * * *
EXP_PATTERN=YYYYMMDDHHmm
EXP_LIMIT=5

PUBLIC_PATH=dist/public
STATIC_PATH=${STORAGE_PATH}/static

ORIGIN_PATH=${STATIC_PATH}/origin